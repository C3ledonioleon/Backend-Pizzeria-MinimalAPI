@model MVC.Pizzeria.Models.Pedido

@{
ViewData["Title"] = "Mi Pedido";
}

<div class="container py-5">

```
<div class="text-center mb-5">

    <h1 class="fw-bold">
        🛒 Mi Pedido
    </h1>

    <p class="text-muted">
        Revisá las pizzas que agregaste a tu pedido.
    </p>

</div>


@if (Model.Detalles != null && Model.Detalles.Any())
{
    <div class="row justify-content-center">

        <div class="col-md-9">

            @foreach (var detalle in Model.Detalles)
            {
                <div class="card shadow-sm mb-3">

                    <div class="card-body">

                        <div class="row align-items-center">

                            <div class="col-md-6">

                                <h4 class="fw-bold">
                                    🍕 @(string.IsNullOrWhiteSpace(detalle.NombrePizza)
                                        ? $"Pizza #{detalle.IdPizza}"
                                        : detalle.NombrePizza)
                                </h4>

                                <p class="text-muted mb-2">
                                    Detalle: @detalle.Cantidad unidad(es) de esta pizza
                                </p>

                                @if (!string.IsNullOrWhiteSpace(detalle.Observaciones))
                                {
                                    <p class="small mb-0">
                                        <strong>Observaciones:</strong> @detalle.Observaciones
                                    </p>
                                }

                                <p class="text-muted mb-0">
                                    Precio unitario:
                                    $@detalle.PrecioUnitario.ToString("N0")
                                </p>

                            </div>


                            <div class="col-md-3 text-center">

                                <span class="fw-bold">
                                    Cantidad:
                                </span>

                                <div class="d-flex justify-content-center align-items-center gap-2">
                                    <form asp-action="Disminuir" method="post">
                                        <input type="hidden" name="idPizza" value="@detalle.IdPizza" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm" title="Quitar una unidad">−</button>
                                    </form>

                                    <span class="badge bg-danger fs-6">@detalle.Cantidad</span>

                                    <form asp-action="Incrementar" method="post">
                                        <input type="hidden" name="idPizza" value="@detalle.IdPizza" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm" title="Agregar otra unidad">+</button>
                                    </form>
                                </div>

                            </div>


                            <div class="col-md-3 text-end">

                                <span class="fw-bold text-danger fs-5">

                                    $@((detalle.Cantidad *
                                        detalle.PrecioUnitario)
                                        .ToString("N0"))

                                </span>

                            </div>

                        </div>

                    </div>

                </div>
            }


            <!-- TOTAL -->

            <div class="card shadow-sm mt-4">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <h3 class="fw-bold mb-0">
                            Total
                        </h3>

                        <h2 class="fw-bold text-danger mb-0">
                            $@Model.Total.ToString("N0")
                        </h2>

                    </div>


                    <div class="d-grid gap-2 mt-4">
                        <a asp-controller="Home" asp-action="Index" asp-fragment="menu" class="btn btn-warning">
                            + Agregar otra pizza
                        </a>

                        <form asp-action="Cancelar" method="post">
                            <button type="submit" class="btn btn-outline-danger w-100">
                                Cancelar pedido
                            </button>
                        </form>
                    </div>

                </div>

            </div>

        </div>

    </div>
}
else
{
    <div class="text-center">

        <div class="alert alert-warning">

            🛒 Tu pedido está vacío.

        </div>


          <a asp-controller="Home"
              asp-action="Index"
              asp-fragment="menu"
              class="btn btn-warning">

            🍕 Volver al menú

        </a>

    </div>
}
```

</div>
