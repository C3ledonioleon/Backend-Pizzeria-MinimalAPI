@model List<MVC.Pizzeria.Models.Pizza>

@{
ViewData["Title"] = "Pizzería Arte & Sabor";
}

<!-- HERO / PORTADA -->

<section class="hero-section text-center py-5 bg-dark text-white rounded-3 mb-5 position-relative overflow-hidden">

```
<div class="container py-4">

    <span class="badge bg-warning text-dark mb-2 fs-6">
        Receta Artesanal
    </span>

    <h1 class="display-3 fw-bold mb-3">
        🍕 Pizzería Arte & Sabor
    </h1>

    <p class="lead col-md-8 mx-auto text-light">
        Disfrutá la auténtica experiencia italiana:
        ingredientes frescos, masa madre horneada a la piedra
        y la mozzarella más cremosa.
    </p>

    <div class="mt-4">

        <a href="#menu"
           class="btn btn-warning btn-lg me-2 fw-semibold shadow-sm">
            Ver Nuestro Menú
        </a>

        <a href="#contacto"
           class="btn btn-outline-light btn-lg fw-semibold">
            Reservar Mesa
        </a>

    </div>

</div>


</section>

<!-- MENÚ / ESPECIALIDADES -->

<section class="menu-section py-4" id="menu">

<div class="text-center mb-5">

    <h2 class="fw-bold fs-1 text-primary">
        Nuestras Especialidades
    </h2>

    <p class="text-muted fs-5">
        Las pizzas favoritas de nuestros clientes,
        hechas con amor y masa fresca del día.
    </p>

</div>


<div class="row row-cols-1 row-cols-md-3 g-4">

    @if (Model != null && Model.Any())
    {
        @foreach (var pizza in Model)
        {
            <div class="col">

                <div class="card h-100 border-0 shadow-sm pizza-card">

                    <!-- IMAGEN -->

                    <div class="position-relative overflow-hidden">

                        @if (pizza.IdPizza == 1)
                        {
                        <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRwu6oawq4oB9SETZujr5uIuqhRbKWF2p0E0m1lJ6dLCw&s=10"
                             class="card-img-top pizza-img"
                             alt="Pizza Muzzarella">
                        }
                        else if (pizza.IdPizza == 2)
                        {
                        <img src="https://images.unsplash.com/photo-1574071318508-1cdbab80d002?auto=format&fit=crop&w=500&q=80"
                             class="card-img-top pizza-img"
                             alt="Pizza Napolitana">
                        }
                        else if (pizza.IdPizza == 3)
                        {
                        <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTQ0-yRhzHKsj6-iuptG3ILauZfwH2shqLC6cP8xsA-tg&s=10"
                             class="card-img-top pizza-img"
                             alt="Pizza Fugazzeta">
                        }
                        else if (pizza.IdPizza == 4)
                        {
                        <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTQdXo4jO4UtaWE_HMgBJjCCLEKelA-SKrN6DkOOw_lTSo_Q91qKr3ZPCg&s=10"
                             class="card-img-top pizza-img"
                             alt="Pizza Especial">
                        }
                        else if (pizza.IdPizza == 5)
                        {
                        <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQdxHl22AlWP59qGUEhJUg5wFzKyUYY-5azyUkoG12brJuFvvaEvXJLwO4v&s=10"
                             class="card-img-top pizza-img"
                             alt="Pizza Calabresa">
                        }
                        else if (pizza.IdPizza == 6)
                        {
                        <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTJDPcUg68SjSgwWk8UJ4DRbR3UaZR_hGGb1x7rav01B6FYJG3pqjenW2s&s=10"
                             class="card-img-top pizza-img"
                             alt="Pizza Cuatro Quesos">
                        }
                
                        <!-- PRECIO -->

                        <span class="badge bg-danger position-absolute top-0 end-0 m-3 fs-6">
                            $@pizza.Precio.ToString("N0")
                        </span>

                    </div>


                    <!-- INFORMACIÓN -->

                    <div class="card-body d-flex flex-column">

                        <h3 class="card-title h4 fw-bold">
                            @pizza.Nombre
                        </h3>

                        <p class="card-text text-muted flex-grow-1">
                            @pizza.Descripcion
                        </p>


                        <!-- INGREDIENTES -->

                        @if (pizza.Ingredientes != null && pizza.Ingredientes.Any())
                        {
                            <p class="small text-muted mb-2">

                                <strong>Ingredientes:</strong>

                                @string.Join(", ", pizza.Ingredientes)

                            </p>
                        }


                        <!-- AGREGAR AL PEDIDO -->
                                <form asp-controller="Pedido"
                                    asp-action="Agregar"
                                    method="post">

                                
                                <input type="hidden"
                                    name="idPizza"
                                    value="@pizza.IdPizza" />

                                <button type="submit"
                                        class="btn btn-outline-danger w-100 fw-bold mt-3">

                                    <i class="bi bi-cart-plus me-1"></i>

                                    Agregar al Pedido

                                </button>
                                

                        </form>


                    </div>

                </div>

            </div>
        }
    }
    else
    {
        <!-- SIN PIZZAS -->

        <div class="col-12">

            <div class="alert alert-warning text-center">

                No hay pizzas disponibles en este momento.

            </div>

        </div>
    }

</div>
```

</section>
