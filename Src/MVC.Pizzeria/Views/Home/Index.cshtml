@{
    ViewData["Title"] = "Pizzería";
}


<!-- =========================
     PORTADA
     ========================= -->

<section class="hero">

    <div class="hero-content">

        <h1>🍕 Pizzería</h1>

        <h2>
            La mejor pizza, en tu mesa
        </h2>

        <p>
            Disfrutá nuestras pizzas hechas
            con ingredientes frescos y mucho sabor.
        </p>

        <a href="#menu"
           class="btn-pizzeria">

            Ver nuestro menú

        </a>

    </div>

</section>


<!-- =========================
     MENÚ
     ========================= -->

<section class="menu-section"
         id="menu">

    <h2>
        Nuestras especialidades
    </h2>

    <p class="section-description">

        Algunas de nuestras pizzas más populares

    </p>


    <div class="pizza-container">


        <!-- MUZZARELLA -->

        <div class="pizza-card">

            <div class="pizza-image">

                🍕

            </div>


            <div class="pizza-card-body">

                <h3>
                    Muzzarella
                </h3>

                <p>
                    Salsa de tomate,
                    mozzarella y orégano.
                </p>

                <span class="pizza-price">

                    $8.000

                </span>

                <button class="btn-pizzeria">

                    Agregar al pedido

                </button>

            </div>

        </div>


        <!-- NAPOLITANA -->

        <div class="pizza-card">

            <div class="pizza-image">

                🍕

            </div>


            <div class="pizza-card-body">

                <h3>
                    Napolitana
                </h3>

                <p>
                    Mozzarella, tomate fresco,
                    ajo y orégano.
                </p>

                <span class="pizza-price">

                    $9.000

                </span>

                <button class="btn-pizzeria">

                    Agregar al pedido

                </button>

            </div>

        </div>


        <!-- ESPECIAL -->

        <div class="pizza-card">

            <div class="pizza-image">

                🍕

            </div>


            <div class="pizza-card-body">

                <h3>
                    Especial
                </h3>

                <p>
                    Mozzarella, jamón,
                    morrones y aceitunas.
                </p>

                <span class="pizza-price">

                    $10.000

                </span>

                <button class="btn-pizzeria">

                    Agregar al pedido

                </button>

            </div>

        </div>


    </div>

</section>